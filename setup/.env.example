# === MACHINES ===
NOVA_HOST=localhost
RIG_HOST=nova-rig

# === INFERENCE (nova-rig) ===
INFERENCE_HOST=http://${RIG_HOST}:8080
INFERENCE_API_KEY=changeme
INFERENCE_BACKEND=llamacpp

# llama.cpp specific
LLAMACPP_MODEL=nemotron-122b.gguf
LLAMACPP_CTX_SIZE=131072
LLAMACPP_PARALLEL=1

# vLLM specific (for when you upgrade)
VLLM_MODEL=nemotron-122b-awq
VLLM_TENSOR_PARALLEL=8
VLLM_MAX_MODEL_LEN=1048576

# === GLM FALLBACK ===
GLM_API_KEY=your-glm-api-key
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# === POSTGRESQL ===
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openclaw
POSTGRES_PORT=5432
DATABASE_URL=postgresql://openclaw:changeme@localhost:5432/openclaw

# === ELASTICSEARCH ===
ES_PORT=9200
ES_JAVA_OPTS=-Xms4g -Xmx4g

# === REDIS ===
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === RAGFLOW ===
RAGFLOW_PORT=9380
RAGFLOW_API_KEY=changeme

# === MEMOS ===
MEMOS_PORT=5230
MEMOS_DRIVER=postgres

# === MEMOS CLOUD (MemOS Plugin) ===
MEMOS_API_KEY=your-memos-cloud-api-key
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
MEMOS_USER_ID=openclaw-user
MEMOS_RECALL_GLOBAL=true
MEMOS_MULTI_AGENT_MODE=true

# === SURFSENSE ===
SURFSENSE_PORT=8000

# === CRAWL4AI ===
CRAWL4AI_PORT=11235

# === OPENCLAW ===
OPENCLAW_PORT=18789
OPENCLAW_MODEL=nemotron

# === NOTEBOOKLM ===
NOTEBOOKLM_NOTEBOOK_ID=0f502fd6-fdeb-49bf-bc50-d759bf38483e

# === TAVILY ===
TAVILY_API_KEY=your-tavily-api-key

# === GOOGLE WORKSPACE ===
GWS_CLIENT_ID=your-client-id
GWS_CLIENT_SECRET=your-client-secret

# === OBSIDIAN ===
OBSIDIAN_VAULT_PATH=/mnt/ssd/obsidian-vault
OBSIDIAN_GIT_REMOTE=your-git-remote-url

# === CHANNEL (pick one) ===
TELEGRAM_BOT_TOKEN=your-telegram-token
# DISCORD_BOT_TOKEN=your-discord-token
# SLACK_BOT_TOKEN=your-slack-token
